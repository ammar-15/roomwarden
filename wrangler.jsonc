{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roomwarden",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the form endpoint runs Worker code; every other request is served straight from /public.
    "run_worker_first": ["/api/*"],
    // /faq serves faq.html, /blog/post-name serves blog/post-name.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "send_email": [
    {
      "name": "EMAIL",
      // Demo requests can only ever be sent to this address.
      "destination_address": "ammar@roomwardenadmin.com"
    }
  ],
  "d1_databases": [
    {
      // Every demo request is saved here before it's emailed, so none get lost.
      "binding": "DB",
      "database_name": "roomwarden-leads",
      "database_id": "2056bc19-e4ec-4b06-a090-c491e0562a90"
    }
  ],
  "vars": {
    "CONTACT_TO": "ammar@roomwardenadmin.com",
    // Must be an address on a domain in your Cloudflare account with Email Routing turned on.
    "CONTACT_FROM": "forms@roomwarden.com"
  },
  "observability": { "enabled": true }
}
